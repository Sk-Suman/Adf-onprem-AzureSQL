{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-onprem-ws"
		},
		"ls_getmetadata_FileServer1_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_getmetadata_FileServer1'"
		},
		"ls_source_FileServer1_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_source_FileServer1'"
		},
		"AzureKeyVault1_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://Azure-SQL-credential.vault.azure.net/"
		},
		"ls_getmetadata_FileServer1_properties_typeProperties_host": {
			"type": "string",
			"defaultValue": "E://"
		},
		"ls_getmetadata_FileServer1_properties_typeProperties_userId": {
			"type": "string",
			"defaultValue": "DESKTOP-8J30P96\\DELL"
		},
		"ls_sink_AzureSqlDatabase1_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "server-suman-host.database.windows.net"
		},
		"ls_sink_AzureSqlDatabase1_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "db-Suman-database"
		},
		"ls_sink_AzureSqlDatabase1_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "suman"
		},
		"ls_source_FileServer1_properties_typeProperties_host": {
			"type": "string",
			"defaultValue": "E://"
		},
		"ls_source_FileServer1_properties_typeProperties_userId": {
			"type": "string",
			"defaultValue": "DESKTOP-8J30P96\\DELL"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-onprem-ws_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_getmetadata_FileServer1_password": {
						"value": "[parameters('ls_getmetadata_FileServer1_password')]"
					},
					"ls_source_FileServer1_password": {
						"value": "[parameters('ls_source_FileServer1_password')]"
					},
					"AzureKeyVault1_properties_typeProperties_baseUrl": {
						"value": "[parameters('AzureKeyVault1_properties_typeProperties_baseUrl')]"
					},
					"ls_getmetadata_FileServer1_properties_typeProperties_host": {
						"value": "[parameters('ls_getmetadata_FileServer1_properties_typeProperties_host')]"
					},
					"ls_getmetadata_FileServer1_properties_typeProperties_userId": {
						"value": "[parameters('ls_getmetadata_FileServer1_properties_typeProperties_userId')]"
					},
					"ls_sink_AzureSqlDatabase1_properties_typeProperties_server": {
						"value": "[parameters('ls_sink_AzureSqlDatabase1_properties_typeProperties_server')]"
					},
					"ls_sink_AzureSqlDatabase1_properties_typeProperties_database": {
						"value": "[parameters('ls_sink_AzureSqlDatabase1_properties_typeProperties_database')]"
					},
					"ls_sink_AzureSqlDatabase1_properties_typeProperties_userName": {
						"value": "[parameters('ls_sink_AzureSqlDatabase1_properties_typeProperties_userName')]"
					},
					"ls_source_FileServer1_properties_typeProperties_host": {
						"value": "[parameters('ls_source_FileServer1_properties_typeProperties_host')]"
					},
					"ls_source_FileServer1_properties_typeProperties_userId": {
						"value": "[parameters('ls_source_FileServer1_properties_typeProperties_userId')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}